# Copy to .env (never commit). Keys stay server-side only.
GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lugha
DB_USER=lugha_app
DB_PASSWORD=
# Frontend → backend URL (Cloud Run URL of lugha-api in prod)
NEXT_PUBLIC_API_BASE=http://localhost:8000
# TTS/STT use ADC (gcloud auth application-default login) — no key in env
